# Optional analytics. Leave unset to avoid loading Google Analytics.
NEXT_PUBLIC_GA_ID=

# Preferred inquiry delivery: a CRM/automation webhook.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=

# Email fallback used when no webhook URL is configured.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="Medoxy Website <website@your-verified-domain.example>"
INQUIRY_TO_EMAIL=info@medoxyhealthcare.com
